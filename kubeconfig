apiVersion: v1
clusters:
- cluster:
    insecure-skip-tls-verify: true
    server: https://127.0.0.1:6443
  name: kubernetes
- cluster:
    server: https://127.0.0.1:6443
  name: scratch-cluster
contexts:
- context:
    cluster: kubernetes
    user: admin
  name: default
- context:
    cluster: scratch-cluster
    user: scratch-user
  name: scratch-context
current-context: default
kind: Config
users:
- name: admin
  user:
    token: admin-token
- name: scratch-user
  user: {}